#compdef rworker rk
# zsh completion for rworker (`rworker completions zsh`). Actions, flags and values come
# from `rworker __spec`; workers, with kind, agent, topic and expiry, from
# `rworker __workers` (the cached last ls, refreshed in the background), so
# TAB never waits on the network.

_rworker_spec() {
  (( ${+_rworker_spec_cache} )) || _rworker_spec_cache=("${(@f)$(rworker __spec 2>/dev/null)}")
}

_rworker_icon_colors() {
  [[ -z "${NO_COLOR:-}" && "$TERM" != dumb ]] || return 0
  zmodload -i zsh/complist || return 0
  # complist counts the printed UTF-8 bytes when applying a captured color.
  # Extend each three-byte glyph capture by two characters, and each
  # four-byte glyph capture by three, to color just the glyph.
  _comp_colors=(
    '=(#b)( ?)*=0=38;2;0;0;0'
    '=(#b)( ?)*=0=38;2;226;67;41'
    '=(#b)( ?)*=0=38;2;218;26;50'
    '=(#b)( ?)*=0=38;2;217;119;87'
    '=(#b)( ?)*=0=38;2;200;200;200'
    '=(#b)( ?)*=0=38;2;126;186;228'
    '=(#b)([󱁤󰒋󰒉󰚩󰔈] ??)*=0=36'
    "${_comp_colors[@]}"
  )
}

_rworker_rows() {
  local tag="$1" heading="$2" line value rest description icon label expl
  shift 2
  local -a _rw_matches _rw_labels
  local verbose=0 has_icons=0
  zstyle -T ":completion:${curcontext}:$tag" verbose && verbose=1
  for line in "$@"
  do
    [[ -n "$line" ]] || continue
    value="${line%%$'\t'*}"
    rest="${line#*$'\t'}"
    description="${rest%%$'\t'*}"
    icon=""
    [[ "$rest" == *$'\t'* ]] && icon="${rest#*$'\t'}"
    label="$value"
    if [[ -n "$icon" ]]
    then
      label="$icon $label"
      has_icons=1
    fi
    if (( verbose )) && [[ -n "$description" ]]
    then
      label+=" -- $description"
    fi
    _rw_matches+=("$value")
    _rw_labels+=("$label")
  done
  (( has_icons )) && _rworker_icon_colors
  if [[ "$tag" == workers && "$_rworker_action" == cp ]]
  then
    compadd "${_rw_worker_options[@]}" -S : -o match -d _rw_labels -a _rw_matches
  else
    _wanted "$tag" expl "$heading" compadd -o match -d _rw_labels -a _rw_matches
  fi
}

_rworker_workers() {
  local -a _rw_worker_options=("$@")
  if [[ "$PREFIX" == *@* ]]
  then
    compset -P '*@'
  fi
  _rworker_rows workers worker "${(@f)$(rworker __workers "${_rworker_action:-}" 2>/dev/null)}"
}

# Topics, agents and agent ids of the cached workers (rworker __values SET),
# with the workers that have them. A leading ! (invert the filter) stays.
_rworker_values() {
  # _arguments puts its compadd options (-J GROUP ...) first.
  local set="${@[-1]}"
  if [[ "$set" == *-re ]]
  then
    compset -P '!'
  fi
  _rworker_rows values "${set%-re}" "${(@f)$(rworker __values "$set" 2>/dev/null)}"
}

# Structured worker search is available as a positional term on ls and logs.
_rworker_search() {
  case "$PREFIX" in
    topic:*) compset -P 'topic:'; _rworker_values topic-re ;;
    agent:*) compset -P 'agent:'; _rworker_values agent-re ;;
    agent-id:*) compset -P 'agent-id:'; _rworker_values id-re ;;
    *)
      local -a filters
      filters=(${=${${(M)_rworker_spec_cache:#values search-filter *}#values search-filter }})
      compadd -S '' -- "${filters[@]}"
      ;;
  esac
}

_rworker_search_flags() {
  local action="$1" line flag
  local -a options
  for line in "${_rworker_spec_cache[@]}"
  do
    if [[ "$line" == "flag $action "* ]]
    then
      flag="${line#flag $action }"
      flag="${flag%% *}"
      options+=("${flag%%=*}")
    elif [[ "$line" == 'global '* ]]
    then
      flag="${line#global }"
      options+=("${flag%% *}")
    fi
  done
  options+=(--help)
  compadd -- "${options[@]}"
}

_rworker_log_target() {
  local w skipval=0
  _rworker_job_worker=""
  for w in "${(@)words[3,CURRENT-1]}"
  do
    if (( skipval ))
    then
      skipval=0
      continue
    fi
    case "$w" in
      --lines|--topic|--agent|--agent-id|--redact-regex|--filter|--grep|-g) skipval=1 ;;
      topic:*|agent:*|agent-id:*|-*) ;;
      *) _rworker_job_worker="$w"; break ;;
    esac
  done
}

_rworker_jobs() {
  local worker="${_rworker_job_worker:-}"
  local -a jobs
  jobs=(${(@f)$(rworker __jobs "$worker" 2>/dev/null)})
  _describe -t jobs 'job' jobs
}

_rworker() {
  _rworker_spec
  local line action
  local -a actions flags takes_worker dynamic
  for line in "${_rworker_spec_cache[@]}"
  do
    case "${line%% *}" in
      action)
        line="${line#action }"
        actions+=("${line%% *}:${line#* }")
        ;;
      alias)
        line="${line#alias }"
        actions+=("${line%% *}:${${line#* }#* }")
        ;;
      worker)
        takes_worker=(${=line#worker })
        ;;
      dynamic)
        dynamic=(${=line#dynamic })
        ;;
    esac
  done

  if (( CURRENT == 2 ))
  then
    _describe -t actions 'action' actions
    return
  fi

  action=$(rworker __action "${words[2]}" 2>/dev/null) || return
  # For _rworker_workers (extend and prune list only ad-hoc workers).
  local _rworker_action="$action"
  if [[ "$action" == help ]]
  then
    (( CURRENT == 3 )) && _describe -t actions 'action' actions
    return
  fi
  local setup_topic
  if [[ "$action" == setup ]]
  then
    local -a topics
    topics=(${=${${(M)_rworker_spec_cache:#values setup-topic *}#values setup-topic }})
    if (( CURRENT == 3 )) && [[ "$PREFIX" != -* ]]
    then
      _describe -t values 'setup topic' topics
      return
    fi
    setup_topic="${words[3]}"
    local worker_pos=4
    if [[ "$setup_topic" == nix ]]
    then
      if (( CURRENT == 4 )) && [[ "$PREFIX" != -* ]]
      then
        topics=(${=${${(M)_rworker_spec_cache:#values setup-nix-topic *}#values setup-nix-topic }})
        _describe -t values 'Nix setup command' topics
        _rworker_workers
        return
      fi
      case "${words[4]}" in
        cache|builder) setup_topic="nix-${words[4]}"; worker_pos=5 ;;
        auth|upload-blob|--) setup_topic="${words[4]}"; worker_pos=5 ;;
      esac
    fi
    if (( CURRENT == worker_pos )) && [[ "$PREFIX" != -* ]]
    then
      _rworker_workers
      return
    fi
    if [[ "$setup_topic" == upload-blob ]] && (( CURRENT > worker_pos ))
    then
      if [[ "${words[CURRENT-1]}" == --name ]]
      then
        _message 'Nix store name'
      elif [[ "$PREFIX" == -* && "${words[(Ie)--]}" == 0 ]]
      then
        compadd -- --name --help --
      else
        _files
      fi
      return
    fi
  fi

  # ssh -l USER NAME: the user, then the worker.
  if [[ "$action" == ssh && "${words[3]}" == -l ]]
  then
    if (( CURRENT == 4 ))
    then
      local -a users
      users=(${=${${(M)_rworker_spec_cache:#values user *}#values user }})
      _describe -t users 'user' users
      return
    elif (( CURRENT == 5 ))
    then
      _rworker_workers
      return
    elif (( CURRENT > 5 ))
    then
      _normal
      return
    fi
  fi
  # Complete search filters before treating the first logs argument as a worker.
  if [[ ( "$action" == machines || "$action" == logs ) && "$PREFIX" != -* ]]
  then
    local previous="${words[CURRENT-1]:-}" _rworker_job_worker=""
    case "$previous" in
      --lines|--topic|--agent|--agent-id|--redact-regex|--filter|--grep|-g|-o|-n|--interval) ;;
      *)
        if [[ "$action" == logs ]]
        then
          _rworker_log_target
        fi
        if [[ -z "$_rworker_job_worker" ]]
        then
          case "$PREFIX" in
            topic:*|agent:*|agent-id:*) _rworker_search; return ;;
          esac
          _rworker_search
          [[ "$action" == logs ]] && _rworker_workers
          [[ -z "$PREFIX" ]] && _rworker_search_flags "$action"
          return
        elif [[ "$action" == logs ]]
        then
          _rworker_jobs
          return
        fi
        ;;
    esac
  fi
  if (( ${takes_worker[(Ie)$action]} )) && (( CURRENT == 3 )) && [[ "$PREFIX" != -* ]]
  then
    _rworker_workers
    return
  fi
  # ssh --create takes up's flags.
  if [[ "$action" == ssh && "${words[3]}" == --create ]] && (( CURRENT > 3 ))
  then
    action=up
  elif [[ "$action" == ssh ]] && (( CURRENT > 3 ))
  then
    _normal
    return
  fi
  # cp: NAME:PATH on one side, local files on the other.
  if [[ "$action" == cp ]]
  then
    if [[ "$PREFIX" == *:* ]]
    then
      _message 'path on the worker'
    else
      _alternative 'workers:worker:_rworker_workers' 'files:file:_files'
    fi
    return
  fi
  if [[ "$action" == sync ]] && (( CURRENT == 4 ))
  then
    _files -/
    return
  fi

  local flag spec_flag values desc _rworker_job_worker="${words[3]:-}"
  if [[ "$action" == logs ]]
  then
    # Search terms are not worker names; find the actual worker, if any.
    _rworker_log_target
    flags+=('1::worker:_rworker_workers' '2::job:_rworker_jobs')
  fi
  for line in "${_rworker_spec_cache[@]}"
  do
    [[ "$line" == "flag $action "* ]] || continue
    line="${line#flag $action }"
    spec_flag="${line%% *}"
    if [[ "$action" == setup ]]
    then
      case "$setup_topic:$spec_flag" in
        niks3-token:--force|register-log-file:--log=path|register-log-file:--topic=topic) ;;
        nix-cache:--dry-run|nix-cache:-n) ;;
        nix-builder:--profile=*|nix-builder:--arch=*|nix-builder:--pool=*) ;;
        nix-builder:--gateway=*|nix-builder:--identity=*|nix-builder:-i=*) ;;
        nix-builder:--host-key=*|nix-builder:--system=*|nix-builder:--jobs=*|nix-builder:--features=*) ;;
        nix:--profile=*|nix:--arch=*|nix:--pool=*|nix:--gateway=*|nix:--identity=*|nix:-i=*) continue ;;
        nix:--host-key=*|nix:--system=*|nix:--jobs=*|nix:--features=*) continue ;;
        auth:--auth-host=*|auth:--dry-run|auth:-n) ;;
        nix:--force|nix:--log=path|nix:--name=*) continue ;;
        nix:*) ;;
        *) continue ;;
      esac
    fi
    desc="${line#* }"
    desc="${desc//\\/\\\\}"
    desc="${desc//\[/\\[}"
    desc="${desc//\]/\\]}"
    if [[ "$spec_flag" == *=path ]]
    then
      flags+=("${spec_flag%%=*}[${desc}]:path:_files")
    elif [[ "$spec_flag" == *=* ]] && (( ${dynamic[(Ie)${spec_flag#*=}]} ))
    then
      flags+=("${spec_flag%%=*}[${desc}]:${spec_flag#*=}:_rworker_values ${spec_flag#*=}")
    elif [[ "$spec_flag" == *=* ]]
    then
      flag="${spec_flag%%=*}"
      values=$(printf '%s\n' "${_rworker_spec_cache[@]}" | sed -n "s/^values ${spec_flag#*=} //p")
      flags+=("${flag}[${desc}]:${spec_flag#*=}:(${values})")
    else
      flags+=("${spec_flag}[${desc}]")
    fi
  done
  for line in "${_rworker_spec_cache[@]}"
  do
    [[ "$line" == "global "* ]] || continue
    line="${line#global }"
    desc="${line#* }"
    desc="${desc//\\/\\\\}"
    desc="${desc//\[/\\[}"
    desc="${desc//\]/\\]}"
    flags+=("${line%% *}[${desc}]")
  done
  flags+=('(-h --help)'{-h,--help}'[show help]')
  # _arguments must only see what follows the action (and its worker):
  # left in, they are positional arguments it has no spec for, and it
  # completes nothing (`rworker extend NAME --tt<TAB>`).
  local skip=2
  if [[ "$action" == setup ]] && (( CURRENT > 3 ))
  then
    skip=3
    [[ "${words[4]:-}" != -* ]] && (( CURRENT > 4 )) && skip=4
    if [[ "$setup_topic" == register-log-file ]] && (( skip == 4 ))
    then
      flags+=('1:job:')
    fi
  fi
  if (( ${takes_worker[(Ie)$action]} )) && [[ "$action" != prune ]]
  then
    if [[ "$action" == logs ]]
    then
      # logs: _arguments sees the worker and job positions itself.
      skip=2
    else
      skip=3
    fi
  elif [[ "$action" == up && "${words[2]}" == ssh ]]
  then
    # ssh --create: skip the --create too.
    skip=3
  fi
  words=("${words[1]}" "${(@)words[skip+1,-1]}")
  (( CURRENT -= skip - 1 ))
  if [[ "$action" == prune ]]
  then
    flags+=('*:worker:_rworker_workers')
  fi
  if [[ "$action" == tui ]]
  then
    values=$(printf '%s\n' "${_rworker_spec_cache[@]}" | sed -n 's/^values tui-view //p')
    flags+=("1::view:(${values})")
  fi
  _arguments -s "${flags[@]}"
}

_rworker "$@"

